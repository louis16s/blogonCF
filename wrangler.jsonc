{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blogoncf",
  "workers_dev": false,
  "preview_urls": false,
  // Keep deployment-specific variables configured in the Cloudflare dashboard.
  "keep_vars": true,
  "main": "dist/server/index.js",
  // Keep this within the compatibility range supported by the pinned
  // Cloudflare Vite/Miniflare runtime so `pnpm dev` and production agree.
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  // Cache public Worker responses at the edge before the script runs.
  "cache": { "enabled": true },
  "images": { "binding": "IMAGES" },
  // Incremental refresh every six hours; reconcile removals and missed edits once daily.
  "triggers": { "crons": ["0 */6 * * *", "15 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogincf-rate-limit",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {},
  "observability": {
    "enabled": true
  }
}
