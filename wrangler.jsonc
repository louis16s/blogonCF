{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blogoncf",
  "workers_dev": false,
  "preview_urls": false,
  "main": "dist/server/index.js",
  // Keep this within the compatibility range supported by the pinned
  // Cloudflare Vite/Miniflare runtime so `pnpm dev` and production agree.
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  // Cache public Worker responses at the edge before the script runs.
  "cache": { "enabled": true },
  "images": { "binding": "IMAGES" },
  // Background sync is hourly; public requests use the durable snapshot.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogincf-rate-limit",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "SITE_URL": "",
    "NOTION_DATA_SOURCE_ID": "",
    "NOTION_CONFIG_DATA_SOURCE_ID": ""
  },
  "observability": {
    "enabled": true
  }
}
