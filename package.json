{
  "name": "blogincf",
  "version": "1.0.0",
  "private": false,
  "description": "A Notion-powered blog rendered entirely on Cloudflare Workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/louis16s/blogonCF.git"
  },
  "keywords": ["notion", "cloudflare-workers", "blog", "vinext", "notionnext"],
  "packageManager": "pnpm@11.9.0",
  "cloudflare": {
    "bindings": {
      "NOTION_TOKEN": {
        "description": "Notion Integration token with read access to the blog database."
      },
      "NOTION_DATA_SOURCE_ID": {
        "description": "Data Source ID of the Notion database containing posts."
      },
      "NOTION_CONFIG_DATA_SOURCE_ID": {
        "description": "Optional Data Source ID of the NotionNext configuration database."
      }
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern outputs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "deploy:worker": "pnpm run db:migrate && wrangler deploy --config wrangler.jsonc",
    "deploy": "pnpm run deploy:worker",
    "release": "pnpm run build && pnpm run deploy:worker",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "heic-to": "1.5.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
